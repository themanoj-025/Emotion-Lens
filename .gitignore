# ==============================================================================
# Emotion-Lens - Security & Production .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SECRETS & ENVIRONMENT VARIABLES (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
.env.local
.env.development
.env.test
.env.staging
.env.production
!.env.example
!.env.template
!.env.sample

# Streamlit secrets
.streamlit/secrets.toml
.streamlit/secrets.toml.local
!.streamlit/secrets.toml.example
!.streamlit/secrets.toml.template

# Private keys, certificates & credentials
*.pem
*.key
*.keystore
*.jks
*.p12
*.pfx
*.pkcs12
*.cer
*.crt
*.der
*.id_rsa
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*

# Cloud & service credentials
credentials.json
client_secret*.json
service-account*.json
service_account*.json
serviceAccountKey*.json
google-services.json
GoogleService-Info.plist
.aws/
.azure/
.gcp/
gcloud/
.act-secrets
*.publishsettings
.kaggle/

# Authentication tokens & configs
.netrc
.pypirc
.npmrc
*token*.json
token.pickle
auth*.json

# ------------------------------------------------------------------------------
# 2. PYTHON RUNTIME, BUILDS & VIRTUAL ENVIRONMENTS
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
.venv*/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# 3. DATASETS & MACHINE LEARNING ARTIFACTS
# ------------------------------------------------------------------------------
train/
test/
mlruns/
saved_model/
*.h5
*.pb
*.keras
*.pt
*.ckpt
*.parquet
*.pkl
*.joblib
*.pickle
*.onnx

# ------------------------------------------------------------------------------
# 4. DATABASE & RUNTIME STORAGE
# ------------------------------------------------------------------------------
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3

# ------------------------------------------------------------------------------
# 5. LOGS & DIAGNOSTICS
# ------------------------------------------------------------------------------
*.log
logs/
*.dump
*.stackdump

# ------------------------------------------------------------------------------
# 6. TESTING & CODE QUALITY
# ------------------------------------------------------------------------------
.cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
radar_balance.txt

# ------------------------------------------------------------------------------
# 7. IDE, EDITORS & JUPYTER
# ------------------------------------------------------------------------------
.ipynb_checkpoints/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.vscode/*.local.*
.vscode/mcp.json
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------------------------
# 8. OS FILES & TEMPORARIES
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/
*.tmp
*.temp
*.bak

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =====================================================================
# KEEP: AI provenance & transparency files — must remain visible
# =====================================================================
!AI_DISCLOSURE.md
!AI_USAGE.md
!PROMPTS.md
!AGENTS.md
!CLAUDE.md
!GEMINI.md
!.cursorrules
!.github/copilot-instructions.md
!.claude/commands/
!.claude/commands/**
!.claude/agents/
!.claude/agents/**
!.claude/settings.json
!docs/ai/
!docs/ai/**
!.ai/
!.ai/**
!ai-provenance.json
!.gitmessage
!CITATION.cff
